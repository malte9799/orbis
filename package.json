    "test": "vitest run"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "hls.js": "^1.7.3",
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^6.14.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "satellite.js": "^5.0.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@types/geojson": "^7946.0.16",
    "@types/three": "^0.183.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^2.1.9",
    "wrangler": "4.157.0"
  },
  "packageManager": "pnpm@10.29.1",
  "pnpm": {
