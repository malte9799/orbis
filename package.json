{
  "name": "orbis",
  "description": "Orbis – Wettervorhersage, Live-Weltkarte und 3D-Sonnensystem",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/assets-manifest.mjs && tsc --noEmit && vite build",
